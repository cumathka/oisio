# ==============================================================================
# OISIO - AI MARKETING INTELLIGENCE PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Security & Session Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET=changeme_in_production_super_secret_key_32bytes_minimum
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oisio?schema=public
REDIS_URL=redis://localhost:6379

# AI Providers (At least one required for AI orchestration)
OPENAI_API_KEY=sk-demo-placeholder-not-real-token
ANTHROPIC_API_KEY=sk-ant-demo-placeholder
GROQ_API_KEY=gsk_demo_placeholder

# Payments & Subscriptions
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Object Storage (S3 / Cloudflare R2 for White-label PDF Reports & Crawl Cache)
S3_BUCKET=oisio-assets
S3_REGION=auto
S3_ENDPOINT=https://example.r2.cloudflarestorage.com
S3_ACCESS_KEY=placeholder_access_key
S3_SECRET_KEY=placeholder_secret_key
